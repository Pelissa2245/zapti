    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^8.3.1",
    "@prisma/client": "^5.12.0",
    "@zapti/database": "file:../../packages/database",
    "@zapti/shared": "file:../../packages/shared",
    "bcryptjs": "^2.4.3",
