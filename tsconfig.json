{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@zapti/shared": ["packages/shared/src"],
      "@zapti/database": ["packages/database/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/node_modules/**", "**/dist/**"],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/database" },
    { "path": "./apps/api" },
    { "path": "./apps/web" }
  ]
}