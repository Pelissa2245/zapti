# ZapTI Environment Configuration - PRODUCTION
# Copy this file to .env on the server and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/zapti

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# JWT - GENERATE NEW SECRETS FOR PRODUCTION!
# ============================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHAR_RANDOM_STRING_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_SECURE_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# ENCRYPTION (32 bytes = 64 hex chars) - GENERATE NEW FOR PRODUCTION!
# ============================================
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_64_HEX_CHAR_STRING_IN_PRODUCTION

# ============================================
# WEBHOOK - GENERATE NEW FOR PRODUCTION!
# ============================================
WEBHOOK_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHAR_STRING_IN_PRODUCTION

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=/data/zapti/media
MAX_FILE_SIZE=52428800

# ============================================
# BACKUP
# ============================================
BACKUP_DIR=/data/zapti/backups

# ============================================
# CORS - UPDATE FOR YOUR DOMAIN
# ============================================
CORS_ORIGIN=http://192.168.1.193:3001

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# FRONTEND URL - UPDATE FOR YOUR DOMAIN
# ============================================
FRONTEND_URL=http://192.168.1.193:3001

# ============================================
# EMAIL (SMTP) - CONFIGURE FOR PRODUCTION
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ============================================
# EVOLUTION API (WhatsApp)
# ============================================
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
