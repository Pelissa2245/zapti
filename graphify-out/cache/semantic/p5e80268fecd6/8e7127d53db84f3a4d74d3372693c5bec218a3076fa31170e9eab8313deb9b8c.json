{"nodes": [{"id": "docs_vault_decisoes_005_multi_tenant_jwt", "label": "ADR 005 Multi-tenant JWT Auth", "file_type": "document", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "Decision to use JWT with tenantId and role for stateless multi-tenant authentication with middleware-based tenant resolution"}, {"id": "adr005_context", "label": "Multi-tenant Auth Requirements", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "Context: each request must know user and tenant for data isolation"}, {"id": "adr005_decision", "label": "JWT with TenantId and Role", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "Decision: JWT payload includes sub, email, role, tenantId; middleware resolves tenant; access 15min, refresh 7 days, HS256"}, {"id": "adr005_jwt_payload", "label": "JWT Payload Structure", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "JWTPayload interface with sub, email, role (ADMIN|SUPER_ADMIN|AGENT|VIEWER), tenantId"}, {"id": "adr005_token_strategy", "label": "Token Strategy", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "Access token 15min, refresh 7 days, HS256 with 32+ char secret"}, {"id": "adr005_middleware", "label": "Middleware Chain", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "Two hooks: JWT verify then tenant resolution (SUPER_ADMIN can override via x-tenant-id header)"}, {"id": "adr005_handler_usage", "label": "Handler Usage Pattern", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "All handlers use request.tenantId for Prisma where clauses"}, {"id": "adr005_login_flow", "label": "Login Flow", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "POST /auth/login with email, password, optional tenantSlug for SUPER_ADMIN"}, {"id": "adr005_super_admin", "label": "Super Admin Impersonation", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "SUPER_ADMIN can act as any tenant via x-tenant-id header"}, {"id": "adr005_alternatives", "label": "Alternatives Considered ADR005", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rationale": "Compared JWT (chosen), Redis sessions, x-tenant-id header only, subdomain per tenant"}, {"id": "adr005_consequences", "label": "Consequences ADR005", "file_type": "concept", "source_file": "docs/vault/Decisoes/005-Multi-Tenant-JWT.md", "source_location": null, "source_url": null, "captured_at": "2026-10-11", "author": "ZapTI Team", "contributor": null, "rati