# ZapTI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zapti

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# ENCRYPTION (32 bytes = 64 hex chars)
# ============================================
ENCRYPTION_KEY=your-32-byte-encryption-key-64-hex-chars-here

# ============================================
# WEBHOOK
# ============================================
WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ============================================
# BACKUP
# ============================================
BACKUP_DIR=./backups

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3001

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:3001

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=matheusserver75@gmail.com
SMTP_PASS=
SMTP_FROM=ZapTI <matheusserver75@gmail.com>
EMAIL_FROM=ZapTI <matheusserver75@gmail.com>

# ============================================
# WHATSAPP BUSINESS API
# ============================================
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# ============================================
# STORAGE (S3 Compatible)
# ============================================
STORAGE_URL=
STORAGE_BUCKET=zapti
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ============================================
# SENTRY (Optional)
# ============================================
SENTRY_DSN=

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_WEBSOCKET=true
FEATURE_SCHEDULER=true
FEATURE_EMAIL=true
FEATURE_BACKUPS=true

# ============================================
# NOTIFICATION EMAIL (for agent alerts)
# ============================================
NOTIFICATION_EMAIL_TO=matheus.b.pelissari@gmail.com